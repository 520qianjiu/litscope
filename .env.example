# ---- LLM (DeepSeek) ----
# 去 https://platform.deepseek.com/api_keys 创建，需先充值
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Embedding（DeepSeek 没有 embeddings 接口）----
# hashing = 离线零依赖；要用真嵌入改成 openai 并填下面三项
EMBEDDING_PROVIDER=hashing
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=

# ---- PubMed（可选，填了会被 NCBI 优先对待）----
PUBMED_EMAIL=
PUBMED_API_KEY=

# ---- 其他 ----
HTTP_TIMEOUT=30
